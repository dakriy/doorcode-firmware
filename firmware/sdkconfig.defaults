# The application's event loop runs on the main task and moves the door's
# whole state, configuration and timeline included, through several call
# frames per event, about 10 KB in one frame; 8 KB overflowed into the heap.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32000
CONFIG_FREERTOS_HZ=1000

# Flash and partitions: 4 MB, two OTA slots (partitions.csv).
# ESP-IDF resolves the path from the project esp-idf-sys generates, in
# target/<target>/<profile>/build/esp-idf-sys-<hash>/out, six levels below
# this directory.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Task watchdog: the main task subscribes and the event queue feeds it; a
# loop iteration stuck for 30 s panics, and a panic reboots.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Brownout detector resets the chip when the supply sags.
CONFIG_ESP_BROWNOUT_DET=y

# Size: an image must fit the table's smaller app slot, 0x1F0000 bytes.
# newlib's nano printf drops the formatting nothing here uses, and failed
# ESP-IDF assertions abort without their message text.
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Updates: the bootloader boots a newly installed image once, pending
# verification, and goes back to the previous one on the next reset unless
# the application has marked it valid. ESP-IDF's own check of signed images
# on update (CONFIG_SECURE_SIGNED_ON_UPDATE) stays off: the application
# checks the signature itself, so the configuration can accept unsigned
# images on a bench board.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Mesh: Mesh-Lite on the IoT bridge, which forwards between the station
# and the soft-AP with NAT, so every door keeps its own address. The
# board's Ethernet port is not a bridge interface.
CONFIG_MESH_LITE_ENABLE=y
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
# CONFIG_BRIDGE_ETHERNET_NETIF_ENABLE is not set

# TLS: a client of TLS 1.2 and TLS 1.3, whichever the server picks.
# ChaCha20-Poly1305 is offered beside AES-GCM under both, so the full
# image accepts every server the stepping-stone image does. TLS 1.3
# agrees keys by ephemeral (EC)DHE only, never by pre-shared key, and
# sends the middlebox compatibility messages. Certificate and host name
# checks are the same under either version.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK is not set
# CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_PSK_EPHEMERAL is not set
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
# Each TLS session holds a 16 KB input buffer, since servers send records
# of up to 16 KB, and an output buffer: 2 KB is enough for every handshake
# message a client sends, and longer writes go out in several records.
# The MQTT session and a firmware download run at once, so this is heap
# the download has. Dynamic buffers would free them between records, but
# ESP-IDF offers them only without TLS 1.3.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048

# lwIP keeps protocol statistics; telemetry reports its TCP counters.
# components/lwip_mib2 adds the MIB2 counters, which hold retransmits.
CONFIG_LWIP_STATS=y

# NVS (16 KB, the standard table's) holds the application's storage only.
# The Wi-Fi driver keeps its settings in RAM; the application remembers
# the last network that associated. The PHY calibrates in full at every
# start instead of storing its calibration data. firmware/src/leftovers.rs
# empties what an earlier firmware's drivers stored.
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set

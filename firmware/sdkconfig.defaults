CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000
CONFIG_FREERTOS_HZ=1000

# Flash and partitions: 4 MB, two OTA slots (partitions.csv).
# ESP-IDF resolves the path from the project esp-idf-sys generates, in
# target/<target>/<profile>/build/esp-idf-sys-<hash>/out, six levels below
# this directory.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Task watchdog: the main task subscribes and the event queue feeds it; a
# loop iteration stuck for 30 s panics, and a panic reboots.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Brownout detector resets the chip when the supply sags.
CONFIG_ESP_BROWNOUT_DET=y

# Size: an image must fit the table's smaller app slot, 0x1F0000 bytes.
# newlib's nano printf drops the formatting nothing here uses, and failed
# ESP-IDF assertions abort without their message text.
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Updates: the bootloader boots a newly installed image once, pending
# verification, and goes back to the previous one on the next reset unless
# the application has marked it valid. ESP-IDF's own check of signed images
# on update (CONFIG_SECURE_SIGNED_ON_UPDATE) stays off: the application
# checks the signature itself, so the configuration can accept unsigned
# images on a bench board.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Mesh: Mesh-Lite on the IoT bridge, which forwards between the station
# and the soft-AP with NAT, so every door keeps its own address. The
# board's Ethernet port is not a bridge interface.
CONFIG_MESH_LITE_ENABLE=y
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
# CONFIG_BRIDGE_ETHERNET_NETIF_ENABLE is not set

# Settings for the bench scripts in scripts/. Copy this file to test.env at
# the repository root (test.env is never committed) and fill it in. Each line
# is KEY=value and is sourced by bash, so quote values that hold spaces.
# A command-line flag of a bench script overrides the value here.
# docs/testing.md describes the bench run.

# The doorcode server's base address, without /api/v1. Required.
DOORCODE_SERVER=http://localhost:8080

# A personal API token of an administrator allowed to manage firmware.
# Required.
DOORCODE_TOKEN=replace-with-an-api-token

# The firmware signing key's private PEM file. Keep it outside the
# repository. Required by the steps that release a signed image.
DOORCODE_SIGNING_KEY=/path/outside/the/repository/signing.key

# The serial port of the board's USB bridge. Default /dev/ttyUSB0.
DOORCODE_SERIAL_PORT=/dev/ttyUSB0

# The name of the door the bench run creates for the board. Default
# "Bench board".
DOORCODE_DOOR_NAME="Bench board"

# How many seconds each step waits for its outcome; firmware updates wait
# three times as long. Default 60.
DOORCODE_TIMEOUT_S=60
